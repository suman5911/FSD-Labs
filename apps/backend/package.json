{
  "name": "@fsd/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && npm run seed && npm run build"
  },
  "dependencies": {
    "@fsd/shared": "*",
    "@prisma/client": "^6.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "prisma": "^6.18.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3"
  }
}
