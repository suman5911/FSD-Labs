{
  "name": "fsd-labs",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@fsd/frontend\" \"npm run dev --workspace=@fsd/backend\"",
    "start:frontend": "npm run dev --workspace=@fsd/frontend",
    "start:backend": "npm run dev --workspace=@fsd/backend",
    "build": "npm run build --workspace=@fsd/backend && npm run build --workspace=@fsd/frontend",
    "lint": "npm run lint --workspace=@fsd/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
